{
    "name": "libtiff",
    "description": "TIFF image decoder",
    "filters":["tiffdec","rftiff"],
    "help": "This filter decodes TIFF images using libtiff.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libtiff.accessor",
    "filter_source":{
        "tiffdec" : "dec_tiff.c",
        "rftiff" : "reframe_tiff.c"
    },
    "extension":{
      "tif" : "img",
      "tiff" : "img"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "runtime": {
        "tiffdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_RGB"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "expired",
        "note": "TIFF (LZW), 2004",
        "checked": "2026-10-16"
    }
}
